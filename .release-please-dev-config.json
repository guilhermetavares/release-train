{
    "packages": {
        ".": {
            "changelog-path": "DEV-CHANGELOG.md",
            "release-type": "simple",
            "label": "dev",
            "release-label": "dev",
            "tag-prefix": "dev-",
            "component": "dev",
            "include-component-in-tag": true,
            "bump-minor-pre-major": false,
            "bump-patch-for-minor-pre-major": false,
            "draft": false,
            "prerelease": false,
            "group-pull-request-title-pattern": "chore${scope}: release  dev-v${version}",
            "pull-request-title-pattern": "chore${scope}: release ${component} v${version}",
            "changelog-type": "default",
            "changelog-sections": [
                { "type": "feat",     "section": "Features" },
                { "type": "fix",      "section": "Bugs" },
                { "type": "perf",     "section": "Performance" },
                { "type": "tech-debt", "section": "Tech Debt" },
                { "type": "infra",    "section": "Infractruture" },
                { "type": "seguranca","section": "Security " },
                { "type": "deps",     "section": "Depencencies" },
                { "type": "docs",     "section": "Documentation", "hidden": false },
                { "type": "chore",    "section": "Outros", "hidden": true },
                { "type": "refactor", "section": "Refactor", "hidden": true },
                { "type": "refact", "section": "Refactor", "hidden": true }
            ]
        }
    }
}
